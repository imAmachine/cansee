{
  "manifest_version": 3,
  "name": "CanSee",
  "version": "1.3.1",
  "description": "Модули оформления для поддерживаемых сайтов.",
  "permissions": ["downloads", "storage", "activeTab"],
  "host_permissions": ["https://animevost.org/*", "https://*.vost.pw/*", "https://*.roomfish.ru/*", "https://*.tigerlips.org/*", "https://*.trn.su/*", "https://*.miskuzi.link/*"],
  "background": { "service_worker": "modules/vost-clean/background.js", "type": "module" },
  "action": { "default_title": "CanSee", "default_popup": "popup.html" },
  "content_scripts": [{
    "matches": ["https://animevost.org/*", "https://*.vost.pw/*"],
    "js": ["core/module-state.js", "modules/vost-clean/bootstrap.js"],
    "css": ["modules/vost-clean/host.css"],
    "run_at": "document_start"
  }, {
    "matches": ["https://animevost.org/*", "https://*.vost.pw/*"],
    "js": ["modules/vost-clean/media.js", "modules/vost-clean/site-adapter.js", "modules/vost-clean/content.js"],
    "run_at": "document_end"
  }],
  "web_accessible_resources": [{ "resources": ["modules/vost-clean/content.css"], "matches": ["https://animevost.org/*", "https://*.vost.pw/*"] }]
}
